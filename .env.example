HOST=127.0.0.1
PORT=4173
LOG_LEVEL=info

# Required for procurement, pricing, shipping templates, and download tasks.
# DATABASE_URL=postgresql://merchroute_app:your-password@127.0.0.1:5432/merchroute

# Optional application data override. Use an absolute path.
# APP_DATA_DIR=C:\\path\\to\\merchroute-data
# Optional absolute business media root used when a fresh workflow configuration is created.
# MERCHROUTE_DATA_ROOT=C:\\path\\to\\merchroute-files

# Preferred absolute path to the repository-external runtime environment file.
# Windows default: %LOCALAPPDATA%\\MerchRoute\\secrets\\merchroute.env
# macOS default: ~/Library/Application Support/MerchRoute/secrets/merchroute.env
# MERCHROUTE_ENV_FILE=C:\\absolute\\path\\to\\merchroute.env

# WB automation bridge. The WB publishing root itself is configured in MerchRoute WB listing settings,
# never as an environment variable or a hard-coded drive path.
# WB_AUTOMATION_BASE_URL=http://localhost:5678
# WB_AUTOMATION_KEY=replace-with-the-same-key-used-by-n8n
# WB runtime API is used by n8n after WB Data Tables are migrated to PostgreSQL.
# Configure the same value in MerchRoute and the n8n process environment.
# MERCHROUTE_RUNTIME_KEY=replace-with-a-separate-runtime-api-key
# MERCHROUTE_RUNTIME_BASE_URL=http://127.0.0.1:4173
# Server-only key for WB/OZON credential encryption and domain-separated OZON intake signing.
# Never expose it to n8n or place its file inside N8N_RESTRICT_FILE_ACCESS_TO.
# MERCHROUTE_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# OZON non-default stores stay fail-closed until the multistore n8n fleet has
# been deployed with the controlled apply flow and verified by live GET readback.
# MERCHROUTE_OZON_MULTISTORE_FLEET_READY=false
# MERCHROUTE_OZON_SOURCE_MEDIA_CLEANUP_ENABLED=false
# Optional direct webhook overrides:
# WB_P003_WEBHOOK_URL=http://localhost:5678/webhook/wb/v1/admin
# WB_P001_WEBHOOK_URL=http://localhost:5678/webhook/wb/v1/jobs
# WB_C001_WEBHOOK_URL=http://localhost:5678/webhook/wb/v1/stores/preflight
# Optional title translation mapping. Defaults to workflow W2lSSXE3NUaLW1tD and /webhook/translation-title.
# WB_TITLE_TRANSLATION_WORKFLOW_ID=W2lSSXE3NUaLW1tD
# WB_TITLE_TRANSLATION_WEBHOOK_URL=http://localhost:5678/webhook/translation-title
# OZON title translation uses the dedicated workflow below by default while reusing
# OZON_AUTOMATION_BASE_URL/OZON_AUTOMATION_KEY, or the WB base URL/key as a fallback.
# OZON_TITLE_TRANSLATION_WORKFLOW_ID=HDh0ZNLK2ps5qasR
# OZON_TITLE_TRANSLATION_WEBHOOK_URL=http://localhost:5678/webhook/ozon/translation-title

# Remote binding is blocked unless both values are explicitly enabled.
# HOST=0.0.0.0
# ALLOW_REMOTE=true
