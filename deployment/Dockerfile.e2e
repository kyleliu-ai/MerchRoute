FROM node:22.23.1-bookworm

LABEL org.opencontainers.image.title="MerchRoute fixed-port E2E runner" \
      org.opencontainers.image.version="1.61.1" \
      merchroute.node.version="22.23.1" \
      merchroute.playwright.version="1.61.1"

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN npx --yes playwright@1.61.1 install --with-deps chromium \
    && chmod -R a+rX /ms-playwright

WORKDIR /work
