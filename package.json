{
  "name": "merchroute",
  "version": "0.1.2",
  "description": "Local-first procurement, AI commerce media, review, pricing, shipping, and WB/OZON listing operations platform.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "kyleliu-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyleliu-ai/MerchRoute.git"
  },
  "bugs": {
    "url": "https://github.com/kyleliu-ai/MerchRoute/issues"
  },
  "homepage": "https://github.com/kyleliu-ai/MerchRoute#readme",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "volta": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/start-development.mjs",
    "workflow": "node --import tsx scripts/workflow.mjs",
    "workflow:test": "node --import tsx --test scripts/workflow/*.test.mjs",
    "build": "npm run clean && npm run build -w packages/shared && npm run build -w apps/web && npm run build -w apps/server && node scripts/generate-build-info.mjs",
    "start": "npm run start -w apps/server",
    "test": "npm run build -w packages/shared && npm run test -ws --if-present",
    "test:e2e": "playwright test",
    "release:verify": "node --import tsx scripts/verify-release-completeness.mjs",
    "release:test": "node --import tsx --test scripts/verify-release-completeness.test.mjs scripts/e2e-isolation.test.mjs scripts/package-release-candidate.test.mjs scripts/run-ci-check.test.mjs scripts/verify-ci-gate.test.mjs scripts/workflow/*.test.mjs",
    "release:package": "node --import tsx scripts/package-release-candidate.mjs",
    "e2e:prepare": "tsx tests/e2e/prepare.ts",
    "e2e:server": "node scripts/start-e2e-server.mjs",
    "docs:capture-ui": "node scripts/capture-readme-screenshots.mjs",
    "smoke:wb-presets": "node scripts/smoke-wb-presets.mjs",
    "smoke:wb-multistore-migration": "node scripts/smoke-wb-multistore-migration.mjs",
    "smoke:ozon-multistore-migration": "node scripts/smoke-ozon-multistore-migration.mjs",
    "runtime:ensure-credential-key": "node scripts/ensure-runtime-credential-key.mjs --file=.env.runtime",
    "runtime:separate-secrets": "node scripts/separate-runtime-secrets.mjs",
    "reconcile:ozon-represented-media": "tsx scripts/reconcile-ozon-represented-media.mts",
    "cleanup:wb-source-media": "tsx apps/server/src/scripts/wb-source-media-cleanup.ts",
    "cleanup:ozon-source-media": "tsx apps/server/src/scripts/ozon-source-media-cleanup.ts",
    "migrate:ozon-central-directories": "node scripts/migrate-ozon-central-task-directories.mjs",
    "deployment:export:n8n": "node deployment/n8n/scripts/export-workflows.mjs && node deployment/n8n/scripts/export-credential-requirements.mjs",
    "deployment:export:n8n-one": "node deployment/n8n/scripts/export-one-workflow.mjs",
    "deployment:prepare": "node deployment/scripts/bootstrap.mjs prepare",
    "deployment:preflight": "node deployment/scripts/preflight.mjs",
    "deployment:test": "node --test deployment/scripts/*.test.mjs",
    "n8n-runtime:test": "node deployment/scripts/run-n8n-runtime-tests.mjs",
    "deployment:verify": "node deployment/n8n/scripts/verify-workflows.mjs && node deployment/scripts/verify-repository-safety.mjs",
    "jimeng:test": "node deployment/scripts/run-jimeng-tests.mjs",
    "jimeng:build": "docker build --tag merchroute/jimeng-free-api-all:0.9.1-e002-20260813 integrations/jimeng-free-api-all",
    "versions:check": "node scripts/verify-toolchain-versions.mjs",
    "versions:check:full": "node scripts/verify-toolchain-versions.mjs --full",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run versions:check && npm run deployment:verify && npm run deployment:test && npm run n8n-runtime:test && npm run release:test && npm run typecheck && npm run lint && npm test && npm run build",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "1.61.1",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  }
}
